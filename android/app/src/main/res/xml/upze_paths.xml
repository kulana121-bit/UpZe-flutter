<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths for the in-app updater (authority ${applicationId}.updates).
     The Dart updater saves the downloaded APK under the app cache/support
     dirs (path_provider), so cover cache, files and their external twins. -->
<paths>
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-files-path name="external_files" path="." />
</paths>
